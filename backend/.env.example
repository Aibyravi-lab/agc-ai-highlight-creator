# Vedzovi Backend Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a secure key:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-secure-random-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ─── Operations API (VED-OPS-001) ─────────────────────────────────────────────
# Internal-only, read-only API consumed by Founder Pulse. Independent from
# JWT_SECRET_KEY. Generate a secure key the same way as above.
OPS_API_KEY=replace-with-a-secure-random-hex-string
# OPS_CACHE_TTL_SECONDS=15

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=Vedzovi Backend
APP_VERSION=0.5.0-beta

# ─── URLs ────────────────────────────────────────────────────────────────────
# Development defaults — update for production
FRONTEND_URL=http://localhost:3000

# Production only — set these when ENVIRONMENT=production
ENVIRONMENT=development
# ENVIRONMENT=production
HTTPS_ENABLED=false
PRODUCTION_URL=https://yourdomain.com
WWW_PRODUCTION_URL=https://www.yourdomain.com

# ─── Storage paths (defaults work for local dev) ─────────────────────────────
# UPLOAD_FOLDER=storage/uploads
# FRAME_FOLDER=storage/frames
# HIGHLIGHT_FOLDER=storage/highlights
# THUMBNAIL_FOLDER=storage/thumbnails
# OUTPUT_FOLDER=outputs
# RESULTS_FOLDER=outputs/results
# JOBS_FOLDER=storage/jobs
# DATABASE_FOLDER=data
# DATABASE_NAME=agc.db
# PROGRESS_FILE=storage/progress.json

# ─── Limits ──────────────────────────────────────────────────────────────────
# MAX_UPLOAD_SIZE_MB=500
# MAX_CONCURRENT_JOBS_PER_USER=2
# MAX_CONCURRENT_JOBS=4
# TEMP_CLEANUP_HOURS=24
# DUPLICATE_UPLOAD_WINDOW_MINUTES=10

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up at https://resend.com and verify your sending domain to get an API key.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@vedzovi.com

# ─── PostHog Analytics (backend, optional) ────────────────────────────────────
# Same PostHog project the frontend already uses — POSTHOG_API_KEY should be
# the same value as frontend's NEXT_PUBLIC_POSTHOG_KEY (a public, write-only
# project key, not a secret). Used to fire "Highlights Generated" from the
# authoritative job-completion path instead of client-side polling. Analytics
# are disabled (silent no-op) if either variable is missing or empty.
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ─── AI Scoring Pipeline ─────────────────────────────────────────────────────
# These control the two-pass scoring pipeline and synergy bonus.
# Defaults are tuned for beta; only change if you understand the impact.
# ADAPTIVE_THRESHOLD_ENABLED=true
# ADAPTIVE_THRESHOLD_PERCENTILE=60
# MIN_ADAPTIVE_THRESHOLD=0.15
# DEFAULT_HIGHLIGHT_THRESHOLD=0.20
# FINE_SCAN_WINDOW_SECONDS=5
# COARSE_TRIGGER_MULTIPLIER=0.50
# SYNERGY_ENABLED=true
# SYNERGY_SIGNAL_THRESHOLD=0.50
# SYNERGY_INCREMENT=0.10
# MAX_SYNERGY_MULTIPLIER=1.50
